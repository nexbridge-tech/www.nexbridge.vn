---
layout: base.njk
permalink: "contact.html"
eleventyComputed:
  title: "{{ contact.seo_title }}"
  description: "{{ contact.seo_description }}"
---
<section class="hero-banner" style="padding-bottom:70px">
<div class="hero-glow"></div>
<div class="hero-network">
<svg viewBox="0 0 900 520" preserveAspectRatio="xMaxYMid slice">
<g stroke="#00AEEF" stroke-width="1" opacity=".35">
<line x1="560" y1="90" x2="700" y2="60"/>
<line x1="700" y1="60" x2="830" y2="140"/>
<line x1="560" y1="90" x2="640" y2="200"/>
<line x1="640" y1="200" x2="800" y2="230"/>
<line x1="640" y1="200" x2="560" y2="320"/>
<line x1="560" y1="320" x2="700" y2="400"/>
<line x1="700" y1="400" x2="850" y2="380"/>
<line x1="800" y1="230" x2="850" y2="380"/>
<line x1="800" y1="230" x2="830" y2="140"/>
<line x1="560" y1="320" x2="480" y2="230"/>
<line x1="480" y1="230" x2="560" y2="90"/>
</g>
<g fill="#00AEEF">
<circle class="hero-node" cx="560" cy="90" r="4" style="animation-delay:0s"/>
<circle class="hero-node" cx="700" cy="60" r="3" style="animation-delay:.4s"/>
<circle class="hero-node" cx="830" cy="140" r="5" style="animation-delay:.8s"/>
<circle class="hero-node" cx="640" cy="200" r="4" style="animation-delay:1.2s"/>
<circle class="hero-node" cx="800" cy="230" r="3.5" style="animation-delay:1.6s"/>
<circle class="hero-node" cx="560" cy="320" r="4.5" style="animation-delay:.6s"/>
<circle class="hero-node" cx="700" cy="400" r="3.5" style="animation-delay:1s"/>
<circle class="hero-node" cx="850" cy="380" r="4" style="animation-delay:1.8s"/>
<circle class="hero-node" cx="480" cy="230" r="3" style="animation-delay:2s"/>
</g>
</svg>
</div>
<div class="container">
<div class="hero-banner-inner" style="max-width:640px">
<span class="hero-eyebrow">{{ contact.hero.eyebrow }}</span>
<h1>{{ contact.hero.title }}</h1>
<p class="lead">{{ contact.hero.lead }}</p>
</div>
</div>
</section>

<section class="testimonial section fade-up" style="padding-bottom:40px">
<div class="container">
<div class="section-title center">
<span>{{ contact.testimonial.eyebrow }}</span>
<h2>{{ contact.testimonial.title }}</h2>
</div>
<div class="testimonial-slider">
{% for card in contact.testimonial.cards %}
<div class="testimonial-card">
<div class="testimonial-quote">&ldquo;{{ card.quote }}&rdquo;</div>
<div class="testimonial-footer">
<div class="avatar-placeholder"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c0-3.5 3-6 7-6s7 2.5 7 6"/></svg></div>
<div class="author">— {{ card.author }}</div>
</div>
</div>
{% endfor %}
</div>
</div>
</section>

<section class="quote section">
<div class="container">
<blockquote>&ldquo;{{ contact.quote.text }}&rdquo;</blockquote>
</div>
</section>

<section class="section" style="padding-top:40px">
<div class="container">
<div class="overview-grid contact-grid">

<div>
<div class="section-title">
<span>{{ contact.form.eyebrow }}</span>
<h2>{{ contact.form.title }}</h2>
</div>

<form method="POST" action="https://api.web3forms.com/submit" class="contact-form">
<input type="hidden" name="access_key" value="418a8e02-c4c3-44db-a81a-f5c24ad1f408">
<input type="hidden" name="subject" value="New Contact Form Submission - NexBridge Website">
<input type="hidden" name="redirect" value="https://nexbridge.vn/contact-success.html">
<input type="checkbox" name="botcheck" style="display:none" tabindex="-1" autocomplete="off">

<div class="form-row">
<label><input type="radio" name="inquiry_type" value="New Inquiry" checked> New Inquiry</label>
<label><input type="radio" name="inquiry_type" value="Partnership"> Partnership</label>
<label><input type="radio" name="inquiry_type" value="Technical Support"> Technical Support</label>
</div>

<div class="form-grid">
<input type="text" name="name" placeholder="Full Name" required>
<input type="email" name="email" placeholder="Work Email" required>
<input type="text" name="company" placeholder="Company">
<input type="text" name="phone" placeholder="Phone (optional)">
</div>

<textarea name="message" rows="5" placeholder="Tell us about your project or question" required></textarea>

<button type="submit" class="btn btn-primary">Send Message</button>

</form>
</div>

<div class="contact-info-panel">

<div class="mission-cards" style="grid-template-columns:1fr">

<div class="mission-card">
<div class="mission-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M3 11l18-7-7 18-2-8-9-3z"/></svg></div>
<div><h3>{{ contact.info.office_label }}</h3><p>{{ contact.info.office_text | safe }}</p></div>
</div>

<div class="mission-card">
<div class="mission-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 7l9 6 9-6"/></svg></div>
<div><h3>Email</h3><p><a href="mailto:{{ contact.info.email }}">{{ contact.info.email }}</a></p></div>
</div>

<div class="mission-card">
<div class="mission-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="4" y="4" width="16" height="16" rx="2"/><line x1="8" y1="10" x2="8" y2="16"/><circle cx="8" cy="7" r=".6" fill="currentColor" stroke="none"/><line x1="12" y1="13" x2="12" y2="16"/><line x1="16" y1="11" x2="16" y2="16"/></svg></div>
<div><h3>LinkedIn</h3><p><a href="{{ contact.info.linkedin_url }}" target="_blank" rel="noopener">{{ contact.info.linkedin_label }}</a></p></div>
</div>

<div class="mission-card">
<div class="mission-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M9 3h6l5 5v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1z"/><path d="M9 12l2 2 4-4"/></svg></div>
<div>
<h3>{{ contact.info.legal_label }}</h3>
<p>{{ contact.info.legal_name }}<br>
{{ contact.info.legal_name_en }}<br>
Business ID: {{ contact.info.business_id }}</p>
</div>
</div>

</div>
</div>
</div>
</div>
</section>
