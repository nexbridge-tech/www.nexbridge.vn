<div class="knowledge-groups" id="blogGrid">
{% for group in collections.knowledgeByTopic %}
<div class="topic-group" data-topic-group="{{ group.topic }}">

<div class="topic-group-header">
<h3>{{ group.topic }}</h3>
<span class="topic-group-count">{{ group.articles.length }} article{% if group.articles.length != 1 %}s{% endif %}</span>
</div>

<div class="blog-grid">
{% for article in group.articles %}
<a class="card"
   data-search="{{ article.data.title | lower }} {{ article.data.excerpt | lower }} {{ article.data.tags | join(' ') | lower }}"
   href="{{ article.url }}" style="text-decoration:none;color:inherit;display:block">
<div class="card-photo-wrap"><img class="card-photo" loading="lazy" src="{{ article.data.image }}" alt="{{ article.data.title }}"></div>
<div class="card-taxonomy"><span class="blog-tag">{{ article.data.tags[0] }}</span>{% if article.data.series %}<span class="card-series">{{ article.data.series }}</span>{% endif %}</div>
<h3>{{ article.data.title }}</h3>
<p>{{ article.data.excerpt }}</p>
<div class="blog-meta">{{ article.data.date | readableDate }}</div>
</a>
{% endfor %}
</div>

</div>
{% endfor %}
